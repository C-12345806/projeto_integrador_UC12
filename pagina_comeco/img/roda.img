4s;transform:rotate(240deg) translate(146%)}.sonner-loading-bar:nth-child(10){animation-delay:-.3s;transform:rotate(270deg) translate(146%)}.sonner-loading-bar:nth-child(11){animation-delay:-.2s;transform:rotate(300deg) translate(146%)}.sonner-loading-bar:nth-child(12){animation-delay:-.1s;transform:rotate(330deg) translate(146%)}@keyframes sonner-fade-in{0%{opacity:0;transform:scale(.8)}100%{opacity:1;transform:scale(1)}}@keyframes sonner-fade-out{0%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(.8)}}@keyframes sonner-spin{0%{opacity:1}100%{opacity:.15}}@media (prefers-reduced-motion){.sonner-loading-bar,[data-sonner-toast],[data-sonner-toast]>*{transition:none!important;animation:none!important}}.sonner-loader{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);transform-origin:center;transition:opacity .2s,transform .2s}.sonner-loader[data-visible=false]{opacity:0;transform:scale(.8) translate(-50%,-50%)}</style><script async="" src="./roda_files/api.js.download"></script><link rel="stylesheet" type="text/css" href="./roda_files/ef14504d5426.css"><link rel="stylesheet" type="text/css" href="./roda_files/093a0a8e32c7.css"><link rel="stylesheet" type="text/css" href="./roda_files/26268fd9ff85.css"><link rel="stylesheet" type="text/css" href="./roda_files/a5f2da8f291d.css"><link rel="stylesheet" type="text/css" href="./roda_files/9e45158fb7ad.css"><link rel="stylesheet" type="text/css" href="./roda_files/67d11f1928b1.css"><link rel="stylesheet" type="text/css" href="./roda_files/3434dd79f4b4.css"><link rel="stylesheet" type="text/css" href="./roda_files/532a1fbeb47f.css"><link rel="stylesheet" type="text/css" href="./roda_files/7e795ab6c02b.css"><link rel="stylesheet" type="text/css" href="./roda_files/dc4a6f9f7d92.css"><link rel="stylesheet" type="text/css" href="./roda_files/e1e99aaffd71.css"><link rel="stylesheet" type="text/css" href="./roda_files/c7b3a26e7c0a.css"><link rel="stylesheet" type="text/css" href="./roda_files/c1ab3ca954c9.css"><link rel="stylesheet" type="text/css" href="./roda_files/9c7246c610bc.css"><link rel="stylesheet" type="text/css" href="./roda_files/b448a5e37edd.css"><link rel="stylesheet" type="text/css" href="./roda_files/89882f7242ef.css"><link rel="stylesheet" type="text/css" href="./roda_files/ae06c2d91ba6.css"><link rel="stylesheet" type="text/css" href="./roda_files/f813678c40c7.css"><meta http-equiv="origin-trial" content="AlnX2n8fbR+95JAKNy3dCRDeQYJ46G0yr7KdRPQoWh1FvKzmOhwQIFNCWfjj/dQmBLr5nK67TpzCTHvjptvlagkAAABmeyJvcmlnaW4iOiJodHRwczovL2NoYXRncHQuY29tOjQ0MyIsImZlYXR1cmUiOiJXZWJSdGNTY3RwU25hcCIsImV4cGlyeSI6MTgwNjM2NDgwMCwiaXNTdWJkb21haW4iOnRydWV9"><link rel="stylesheet" type="text/css" href="./roda_files/c825ae976f4c.css"><link rel="stylesheet" type="text/css" href="./roda_files/225b7e817ac3.css"><link rel="stylesheet" type="text/css" href="./roda_files/46d45c1982a9.css"><link rel="stylesheet" type="text/css" href="./roda_files/81e8952f7056.css"><link rel="stylesheet" type="text/css" href="./roda_files/32a486438198.css"><link rel="stylesheet" type="text/css" href="./roda_files/4b70751e7b64.css"><link rel="stylesheet" type="text/css" href="./roda_files/c56e66b9a94c.css"><link rel="stylesheet" type="text/css" href="./roda_files/85dfb1dcda0e.css"><link rel="stylesheet" type="text/css" href="./roda_files/95cedbaf4821.css"><link rel="stylesheet" type="text/css" href="./roda_files/5a7fee8bc017.css"><link rel="stylesheet" type="text/css" href="./roda_files/1c80c685f052.css"><link rel="stylesheet" type="text/css" href="./roda_files/cf86acabebd1.css"><link rel="stylesheet" type="text/css" href="./roda_files/5f3e8f9fcc7b.css"><link rel="stylesheet" type="text/css" href="./roda_files/2e8336cff1fc.css"><link rel="stylesheet" type="text/css" href="./roda_files/b23bc2eae490.css"><link rel="stylesheet" type="text/css" href="./roda_files/1fbda8f5f2a6.css"><link rel="stylesheet" type="text/css" href="./roda_files/53832831fb40.css"><link rel="stylesheet" type="text/css" href="./roda_files/69113cbf8a40.css"><link rel="stylesheet" type="text/css" href="./roda_files/966ec46f4fd1.css"><link rel="stylesheet" type="text/css" href="./roda_files/33af36f2af29.css"><link rel="stylesheet" type="text/css" href="./roda_files/0db7211849ca.css"><link rel="stylesheet" type="text/css" href="./roda_files/51d96a086705.css"><link rel="stylesheet" type="text/css" href="./roda_files/bf20f64a5866.css"><link rel="stylesheet" type="text/css" href="./roda_files/5ed5798a10b3.css"><link rel="stylesheet" type="text/css" href="./roda_files/2157c43fe17d.css"><link rel="stylesheet" type="text/css" href="./roda_files/b738f8f85fa5.css"><link rel="stylesheet" type="text/css" href="./roda_files/3cf6bc4ba7a8.css"><link rel="stylesheet" type="text/css" href="./roda_files/65dfcae86c95.css"></head><body data-contain-pane-overscroll="" style="--font-ui-size: 16px; --text-4xl: 36px; --text-3xl: 30px; --text-2xl: 24px; --text-xl: 20px; --text-lg: 18px; --text-base: 16px; --text-sm: 14px; --text-xs: 12px; --text-dynamic-isle-row: 14px; --text-heading-lg: 24px; --text-heading-app: 28px; --text-heading-md: 20px; --text-heading-sm: 18px;"><span data-radix-focus-start="" style="display:contents"></span><script nonce="">
(() => {
  const key = "oai-epic-native-launch";
  let launch = null;
  try { launch = JSON.parse(sessionStorage.getItem(key) || "null"); } catch {}
  function save() {
    try {
      if (launch) sessionStorage.setItem(key, JSON.stringify(launch));
      else sessionStorage.removeItem(key);
    } catch { launch = null; }
  }
  function capture() {
    const fragment = window.location.hash;
    if (!fragment) return;
    window.history.replaceState(window.history.state, "", "/epic/launch");
    const params = new URLSearchParams(fragment.slice(1));
    const snapshot = params.get("snapshot");
    const workspace = params.get("workspace_id");
    launch = Array.from(params).length === (workspace ? 2 : 1) && (!workspace || /^[A-Za-z0-9_-]{1,128}$/.test(workspace)) && snapshot &&
      /^[A-Za-z0-9_-]{80,16384}={0,2}$/.test(snapshot)
      ? { snapshot, workspace, id: crypto.randomUUID(), messageId: null, draftId: null } : null;
    save();
  }
  if (window.location.pathname === "/epic/launch") capture();
  function pending() {
    return launch && !launch.draftId && new URLSearchParams(window.location.search).get("epic_launch") === launch.id
      ? launch.snapshot : null;
  }
  window.__oaiEpicNativeLaunch = {
    get: () => launch?.snapshot ?? null,
    workspace: () => launch?.workspace ?? null,
    destination: () => launch ? "/?surface=work&epic_launch=" + launch.id : "/epic/launch",
    pending,
    ownsMessage: (messageId) => launch?.messageId === messageId,
    metadata: (messageId, draftId) => {
      if (!launch) return;
      if (draftId != null) {
        if (launch.draftId ? launch.draftId !== draftId : !pending()) return;
        launch.draftId = draftId;
      } else if (launch.messageId !== messageId) return;
      const changed = launch.messageId !== messageId;
      launch.messageId = messageId;
      save();
      if (changed) window.dispatchEvent(new Event("oai-epic-launch-changed"));
      return launch ? { epic_launch_snapshot: launch.snapshot } : undefined;
    },
    claimAttachmentNotification: (expected) => {
      if (!launch || launch.snapshot !== expected || launch.attachmentNotified) return false;
      launch.attachmentNotified = true;
      save();
      return true;
    },
    clear: (expected) => {
      if (launch?.snapshot === expected || launch?.messageId === expected) {
        launch = null;
        save();
        window.dispatchEvent(new Event("oai-epic-launch-changed"));
      }
    }
  };
  window.addEventListener("hashchange", () => {
    if (window.location.pathname !== "/epic/launch" || !window.location.hash) return;
    capture();
    window.dispatchEvent(new Event("oai-epic-launch-changed"));
  });
})();
