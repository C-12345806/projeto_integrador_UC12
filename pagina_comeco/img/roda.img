headset_regexes\":[],\"ducking_assistant_echo_gate_enabled\":false,\"ducking_ducked_remote_volume_db\":-6,\"ducking_assistant_echo_gate_minimum_capture_level\":0.04,\"ducking_version\":1},{\"tags\":{\"rct\":{\"enabled\":false,\"source_tags\":[\"rct\"]},\"guideline\":{\"enabled\":false,\"source_tags\":[\"guideline\"]},\"systematic-review\":{\"enabled\":false,\"source_tags\":[\"systematic_review\",\"meta_analysis\",\"network_meta_analysis\"]},\"observational\":{\"enabled\":false,\"source_tags\":[\"observational\"]},\"review\":{\"enabled\":false,\"source_tags\":[\"review\"]}},\"recent\":{\"enabled\":false,\"recent_window_days\":30},\"enabled\":false},{},{\"cutoff_ms\":1783622923641},{\"app_ids\":[\"connector_openai_chatgpt_for_law\",\"plugin_asdk_app_sites_ebc0d32736688191865683c4df79d03c\",\"asdk_app_6adb9577b1ac8191ac727ae60c94621f\",\"plugin_asdk_app_6adb9577b1ac8191ac727ae60c94621f\",\"connector_openai_findata\"],\"mcp_servers\":[\"squatch\"]},{\"learn_more_url\":\"https://help.openai.com/{lang}/collections/8475420-gpts\",\"retirement_date\":\"2026-12-11\",\"disable_gpt_updates\":false,\"disable_gpt_creation\":true},{\"enabled\":true},{\"native_settings_enabled\":true,\"nav_enabled\":true,\"native_plugins_v2\":true,\"redirect_enabled\":true,\"settings_enabled\":true,\"skills_enabled\":true,\"composer_enabled\":true,\"enabled\":true},{\"toolDescription\":\"Redirect the user's request from ChatGPT to {{ destination }} when {{ destination }} is the better execution environment.\\n\\nYou MUST call this tool before doing any work when the request involves:\\n- Browser use or computer-use automation\\n- Building apps, local coding, repository edits, command execution, or file inspection\\n- Opening, updating, reviewing, or otherwise working with PRs\\n- Creating, editing, converting, inspecting or delivering files or artifacts, including implicit requests for downloadable or editable deliverables such as slide decks, `.pptx`, spreadsheets, `.xlsx`, workbooks, documents, `.docx`, or PDFs,\\n- Complex analysis such as financial modeling\\n\\nPrefer answering directly in ChatGPT for:\\n- Email, message, or prose drafting\\n- Brainstorming, planning, or explanation\\n- Code snippets or examples that fit naturally in chat\\n\\nIf the user rejected the suggestion, don't call this tool again.\",\"toolReasonParamDescription\":\"A short user-facing reason why continuing in {{ destination }} would help.\",\"rejectedResponse\":\"The user chose not to hand off.\",\"toolPromptParamDescription\":\"A brief instruction describing what {{ destination }} should do for the user.\",\"acceptedResponse\":\"User chose to hand off:\\n- You can confirm that the new chat has been created but do not link to it until the user asks you to\\n- You can't make any more changes to the new chat! If user wants changes, they need to go the new chat and make changes themselves.\\n- If the user says they can't find the chat, link them using this markdown exactly: [here]({{ thread_url }})\"},{\"incall_banner_enabled\":false,\"home_takeover_animation_enabled\":false,\"incall_voice_model_picker_available\":false,\"wingman_model_picker_default_display_name\":\"Live\",\"home_takeover_enabled\":false,\"wingman_model_name\":\"GPT-Live-1\",\"projects_enabled\":true,\"wingman_model_picker_alternative_options\":[],\"rollout_policy\":\"available_default\",\"rollout_version\":2,\"unavailable_upsell_policy\":\"none\",\"unavailable_upsell_show_upgrade_cta\":false},{\"enabled\":false,\"type\":\"\"},{\"custom_headers\":{}},{\"stream_failure_poll_interval_seconds\":60,\"streaming_off_poll_interval_seconds\":60},{\"min_consolidated_threads\":30,\"enabled\":false,\"dual_write\":true},{\"developer_instructions\":\"Call the Pages create_page tool with only a concise title and source_response set to {{source_response}}. Let the tool copy the selected response without regenerating its content.\",\"dil_rewrite_prompt\":\"Return this response with DIL state and loops removed. Use the initial values in the source to resolve state-dependent content. Expand each loop into its items in order, and remove handlers that only update the removed state.\\n\\nPreserve the original wording and layout. Keep all other DIL components, including images, charts, maps, and other widgets, with their original props and references. Inside a loop, repeat the original components and substitute only the values that depend on the loop or state.\\n\\nReturn only the revised source. If there is no DIL state or loop, return the source unchanged.\",\"prompt\":\"Use the Pages tool to save the response I selected as a Page. Keep its existing layout, give it a short title, and return the Page link.\"},{\"category_ids\":[\"featured\",\"new-and-noteworthy\",\"small-business\",\"real-estate\",\"productivity\",\"communication\",\"creativity\",\"developer tools\",\"healthcare\",\"finance\",\"travel\",\"entertainment\",\"education \u0026 research\",\"sales\",\"business \u0026 operations\",\"data \u0026 analytics\",\"scientific research\",\"security\",\"other\"],\"collapsed_category_ids\":[],\"sections\":[{\"url_slug\":\"new-and-noteworthy\",\"plugin_ids\":[\"plugin_asdk_app_6ad7c4a7c998819189b0aaf871c8d0dd\",\"plugin_asdk_app_6982cfb482bc81918416ec35e7cc90e5\",\"plugin_asdk_app_691eab1e001081919e57189f8b2f03bc\",\"plugin_asdk_app_6aee3584ac1481918d16dce03b28de59\",\"plugin_connector_68e004f14af881919eb50893d3d9f523\",\"plugin_asdk_app_69272cb413a081919685ec3c88d1744e\",\"plugin_connector_6a99cb6846448190875813bf1e8e5504\",\"plugin_connector_6a99cb684648819088fe4d6a0e373614\",\"plugin_asdk_app_6a8d784b60cc81919aeafbfaeda5fbcf\",\"plugin_asdk_app_6a03b72913d88191b464189e99b02d38\",\"plugin_asdk_app_6aa1cd6835e48191b9ade73ac9fcd180\",\"plugin_asdk_app_6a47ca602a648191b777ecea734e4b9d\",\"plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c\",\"plugin_asdk_app_6ab242dbeb5c8191ba5277534ef0c570\",\"plugin_connector_68df33b1a2d081918778431a9cfca8ba\",\"plugin_asdk_app_69b31dc2110c8191b8b47dc98fe5a052\"