false\",\"default\"],[\"1662690995\",\"false\",\"default\"],[\"3014785993\",\"false\",\"6Ajlvt0GOeffJIPmMu9aRh\"],[\"3720285278\",\"false\",\"default\"],[\"3623026190\",\"false\",\"default\"]],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[[\"3640552975\",\"false\",\"default\"]],[]],[28,42,7,4,44,47,20,19,6,1217,13,20,11,16,12,47,12,37,14,12,16,85,20,17,7,35,31,34,2,33,14,122,31,22,2,522,10,6,42,13,27,7,20,143,9,49,218,18,78,6,146,57,9,7,5,78,22,44,5,5,25,36,12,6,93,9,12,14,75,111,20,162,14,202,24,13,3,38,16,324,170,13,36,339,24,31,37,15,26,773,6,8,62,58,2,14,8,187,5,457,626,12,255,12,2,41,12,36,11,22,18,39,38,6,112,15,13,6,33,5,5,8],[{\"en\":{\"workspace_admin\":{\"headline\":\"Help your team find ad credits\",\"body\":\"Ask a workspace owner to check Benefits for the ad credit offer.\"},\"personal\":{\"body\":\"Explore the offer for your team. Already use Business? Switch to your workspace.\",\"headline\":\"Bring your team to Business\"},\"workspace\":{\"headline\":\"Explore workspace ad credits\",\"body\":\"A workspace owner can check Benefits for available offers.\"},\"workspace_member\":{\"body\":\"If your workspace is eligible, an owner can claim ad credits in Benefits. To set up a separate Business workspace, select Continue.\",\"headline\":\"ChatGPT Business\"},\"default\":{\"body\":\"Learn about ad credits for eligible workspaces.\",\"headline\":\"Explore ChatGPT Business\"},\"workspace_owner\":{\"headline\":\"Check your workspace benefits\",\"body\":\"Open Benefits to see whether your workspace is eligible for ad credits.\"},\"personal_upsell\":{\"body\":\"Explore ChatGPT Business and the ad credit offer for eligible workspaces.\",\"headline\":\"Bring your team to Business\"},\"business_claim\":{\"body\":\"Sign in to the account you use for your Business workspace.\",\"headline\":\"Explore workspace ad credits\"}},\"email_selectors\":{\"business_claim\":\"workspace\",\"personal_upsell\":\"personal\",\"parameter\":\"for\"},\"fr\":{\"personal\":{\"headline\":\"Passez à ChatGPT Business avec votre équipe\",\"body\":\"Découvrez l’offre pour votre équipe. Vous utilisez déjà ChatGPT Business ? Accédez à votre espace de travail.\"},\"default\":{\"headline\":\"Découvrez ChatGPT Business\",\"body\":\"En savoir plus sur les crédits publicitaires destinés aux espaces de travail éligibles.\"},\"workspace_member\":{\"headline\":\"ChatGPT Business\",\"body\":\"Si votre espace de travail est éligible, un propriétaire peut demander des crédits publicitaires dans la rubrique « Avantages ». Pour créer un espace de travail Business distinct, sélectionnez « Continuer ».\"},\"workspace_owner\":{\"headline\":\"Consultez les avantages de votre espace de travail\",\"body\":\"Ouvrez la rubrique « Avantages » pour voir si votre espace de travail est éligible aux crédits publicitaires.\"},\"workspace_admin\":{\"body\":\"Demandez à un propriétaire de l’espace de travail de consulter l’offre de crédits publicitaires dans la rubrique « Avantages ».\",\"headline\":\"Aidez votre équipe à trouver des crédits publicitaires\"},\"personal_upsell\":{\"body\":\"Découvrez ChatGPT Business et l’offre de crédits publicitaires destinée aux espaces de travail éligibles.\",\"headline\":\"Passez à ChatGPT Business avec votre équipe\"},\"workspace\":{\"headline\":\"Découvrez les crédits publicitaires pour votre espace de travail\",\"body\":\"Un propriétaire de l’espace de travail peut consulter les offres disponibles dans la rubrique « Avantages ».\"},\"business_claim\":{\"headline\":\"Découvrez les crédits publicitaires pour votre espace de travail\",\"body\":\"Connectez-vous au compte que vous utilisez pour votre espace de travail Business.\"}},\"de\":{\"workspace_owner\":{\"headline\":\"Prüfe die Vorteile deines Workspaces\",\"body\":\"Öffne „Vorteile“, um zu prüfen, ob dein Workspace für Werbeguthaben berechtigt ist.\"},\"workspace_member\":{\"headline\":\"ChatGPT Business\",\"body\":\"Wenn dein Workspace berechtigt ist, kann ein Workspace-Inhaber unter „Vorteile“ Werbeguthaben anfordern. Wähle „Weiter“, um einen separaten Business-Workspace einzurichten.\"},\"business_claim\":{\"body\":\"Melde dich mit dem Konto an, das du für deinen Business-Workspace verwendest.\",\"headline\":\"Entdecke Werbeguthaben für deinen Workspace\"},\"default\":{\"headline\":\"Entdecke ChatGPT Business\",\"body\":\"Erfahre mehr über Werbeguthaben für berechtigte Workspaces.\"},\"personal\":{\"headline\":\"Wechsle mit deinem Team zu ChatGPT Business\",\"body\":\"Entdecke das Angebot für dein Team. Nutzt du ChatGPT Business bereits? Wechsle zu deinem Workspace.\"},\"personal_upsell\":{\"headline\":\"Wechsle mit deinem Team zu ChatGPT Business\",\"body\":\"Entdecke ChatGPT Business und das Angebot für Werbeguthaben für berechtigte Workspaces.\"},\"workspace_admin\":{\"headline\":\"Hilf deinem Team, Werbeguthaben zu finden\",\"body\":\"Bitte einen Workspace-Inhaber, unter „Vorteile“ nach dem Angebot für Werbeguthaben zu sehen.\"},\"workspace\":{\"body\":\"Workspace-Inhaber können unter „Vorteile“ nach verfügbaren Angeboten sehen.\",\"headline\":\"Entdecke Werbeguthaben für deinen Workspace\"}}},{\"text_messaging_enabled\":\"disabled\",\"sentinel_timeout_ms\":250},{\"open_prompt\":\"Your owner assigned you a Page checkbox.\\nCarry out the checkbox wording as your owner's request. Use the linked Page block for context if needed. When the task is complete, check off the assigned checkbox on the linked Page.\",\"done_prompt\":\"Your owner assigned you a Page checkbox.\\nThe checkbox is already complete. Record the assignment without starting new work.\"},{\"url\":\"https://developers.openai.com/codex/concepts/sandboxing\"},{\"max_file_bytes\":268435456,\"max_skill_bundle_read_bytes\":838860800,\"max_skill_total_uncompressed_bytes\":838860800,\"max_visual_editor_archive_bytes\":104857600,\"max_archive_read_bytes\":838860800,\"max_archive_admission_bytes\":817889280,\"max_skill_file_uncompressed_bytes\":268435456,\"max_skill_upload_bytes\"